extends "res://tests/s01_campaign.gd"

func fixture_v2(path:String) -> void:
	state.new_game("human")
	for id in ["1-1","1-2","1-3","2-1","2-2","2-3"]:
		state.reward(id+"/test",4,40)
		state.finish(5)
		if id!="2-3": state.leave_result()
	var old:Dictionary=state.p.duplicate(true)
	for key in ["completed","records","attempt","run_start","last_level","last_result"]: old.erase(key)
	var bytes:=var_to_bytes(old)
	var file:=FileAccess.open(path+".0",FileAccess.WRITE)
	file.store_var({"version":2,"serial":7,"checksum":hash(bytes),"data":bytes})
	file.close()
	var reader=STORE.new()
	reader.prefix=path
	var migrated:Dictionary=reader.read_profile()
	check(reader.valid(migrated) and migrated.level=="3-1" and migrated.wallet==24 and migrated.hearts==3,"v2 six-level save migrates without reset")
	check(migrated.last_level=="2-3" and migrated.last_result.stars==3 and migrated.records.size()==6,"old result screen and bests migrate")
	check(FileAccess.file_exists(path+".0"),"migration does not remove old slot")

func run() -> void:
	state=root.get_node("Campaign")
	var folder:=ProjectSettings.globalize_path("res://reports/temp/molten/campaign-%d"%OS.get_process_id())
	state.store.prefix=folder
	state.store.first_level="1-1"
	await fixture_v2(folder+"-v2")
	state.new_game("ogre")
	state.lose_heart()
	check(state.p.hearts==2 and not state.start_replay("3-3"),"first campaign locked and shared hearts")
	for id in state.ROUTE:
		check(state.p.level==id and state.p.hearts==2,"campaign advances without healing "+id)
		check(state.reward(id+"/coin",5,50) and not state.reward(id+"/coin",5,50),"one unique reward "+id)
		check(state.finish(6) and not state.finish(6),"one completion "+id)
		check(state.store.valid(state.store.read_profile()),"saved completion "+id)
		if id!="3-3": state.leave_result()
	check(state.p.status=="victory" and state.p.completed and state.p.results.size()==9 and state.p.records.size()==9,"final unlock persists for nine levels")
	state.p=state.store.read_profile()
	check(state.p.completed and state.p.wallet==45,"reload retains victory and permanent bank")
	state.leave_result()
	check(state.p.status=="map" and not state.active(),"final result returns to free map")
	var best:int=state.total_record()
	check(state.start_replay("1-1") and state.p.hearts==3 and state.p.ids.is_empty(),"replay starts a fresh run with three hearts")
	state.reward("1-1/coin",1,10)
	state.finish(6)
	check(state.p.wallet==46 and state.total_record()==best and state.p.records["1-1"].stars==2,"weaker replay keeps bank, score record and stars")
	state.leave_result()
	state.start_replay("3-2")
	state.reward("fund",350,3500)
	for i in 3: state.lose_heart()
	check(state.p.status=="offer" and state.p.hearts==0,"free run exhaustion uses normal offer")
	var bank:int=state.p.wallet
	check(state.buy() and state.p.hearts==1 and state.p.wallet==bank-100 and state.price()==200 and not state.buy(),"one paid heart; double purchase rejected; cost rises")
	state.lose_heart()
	state.abandon()
	check(state.p.completed and state.p.wallet==bank-100 and state.p.status=="defeat","free defeat preserves permanent bank and unlock")
	check(state.store.valid(state.store.read_profile()),"free defeat reload valid")
	state.start_replay("3-2")
	check(state.reward("fund",1,10) and not state.reward("fund",1,10),"new map attempt renews IDs exactly once")
	state.save()
	var persisted:Dictionary=state.store.read_profile()
	check(persisted.attempt==3 and persisted.ids.has("fund") and persisted.purchases==1,"attempt, consumed IDs and purchase counter persist")
	# A corrupted newest slot falls back to the other valid write, not a reset.
	state.save()
	var broken:=FileAccess.open("%s.%d"%[state.store.prefix,state.store.serial%2],FileAccess.WRITE)
	broken.store_8(1)
	broken.close()
	var restored:Dictionary=state.store.read_profile()
	check(not restored.is_empty() and restored.completed and not state.store.notice.is_empty(),"damaged save falls back with notice")
	print("MOLTEN CAMPAIGN ","FAIL" if failed else "PASS")
	quit(1 if failed else 0)
