[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/debug/developer_menu.gd" id="1"]
[ext_resource type="Script" path="res://scripts/debug/outlines.gd" id="2"]

[node name="DeveloperMenu" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
script = ExtResource("1")

[node name="Outlines" type="Node2D" parent="."]
visible = false
script = ExtResource("2")

[node name="Modal" type="Control" parent="."]
visible = false
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Shade" type="ColorRect" parent="Modal"]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.02,0.05,0.07,0.76)

[node name="Center" type="CenterContainer" parent="Modal"]
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Panel" type="PanelContainer" parent="Modal/Center"]

[node name="Padding" type="MarginContainer" parent="Modal/Center/Panel"]
theme_override_constants/margin_left = 30
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 30
theme_override_constants/margin_bottom = 24

[node name="List" type="VBoxContainer" parent="Modal/Center/Panel/Padding"]
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Modal/Center/Panel/Padding/List"]
theme_override_font_sizes/font_size = 26
text = "Меню разработчика"

[node name="Collisions" type="CheckButton" parent="Modal/Center/Panel/Padding/List"]
unique_name_in_owner = true
text = "Показывать коллизии"

[node name="Later" type="Label" parent="Modal/Center/Panel/Padding/List"]
theme_override_colors/font_color = Color(0.72,0.78,0.8,1)
text = "На следующих этапах
Сердца, неуязвимость, полёт и скорость
Монеты, форма героя, уровни и босс"

[node name="Close" type="Button" parent="Modal/Center/Panel/Padding/List"]
unique_name_in_owner = true
text = "Закрыть   ·   F1"

[connection signal="pressed" from="Modal/Center/Panel/Padding/List/Close" to="." method="toggle"]
[connection signal="toggled" from="Modal/Center/Panel/Padding/List/Collisions" to="." method="_on_collisions_toggled"]
